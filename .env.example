# Copy to .env.local and fill in values before running locally.
# Never commit .env.local — it is in .gitignore.

# Environment tier: local | dev | staging | production
CELLO_ENV=local

# Local Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/cello_dev

# Dev envelope key for LocalEnvelopeKeyProvider (PERSIST-001 SI-001).
# Must be a 32-byte hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never use this key outside CELLO_ENV=local.
DEV_ENVELOPE_KEY=
