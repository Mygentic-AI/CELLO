# macOS
.DS_Store

# Obsidian vault config
.obsidian/

# Environment files
.env.local
.env.*.local

# Node
node_modules/
# Bare (no trailing slash) so it also matches the node_modules -> node_modules.nosync SYMLINKS at
# every depth (root, demo/, packages/*/) — a symlink is a different filesystem entry from a real
# directory, so the slash-suffixed rule above does not match it on its own.
node_modules

# TypeScript build output
packages/*/dist/
packages/*/tsconfig.tsbuildinfo
packages/*/*.tsbuildinfo

# Claude Code local artifacts
.claude/worktrees/
.claude/skills/
.claude/projects/
.claude-flow/
packages/directory/test-sigterm-*.mjs

# Hibernate/wake operational files (live state, not source)
infra/hibernation-state.json
infra/hibernation-snapshots/

# Python bytecode. ~30 of these were committed by accident on 2026-07-27;
# they never shipped (deploy-lambdas.sh stages *.py only) but they turned every
# test run into a dirty tree.
__pycache__/
*.pyc
infra/.dryrun-ok/

# Renamed out of iCloud sync (".nosync" is skipped by iCloud Drive).
# node_modules is a symlink to this.
node_modules.nosync/
