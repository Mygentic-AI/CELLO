[Unit]
Description=CELLO Demo Agent
After=cello-daemon.service
Requires=cello-daemon.service

[Service]
Type=simple
User=cello-demo
WorkingDirectory=/opt/cello-demo
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
Environment=CELLO_DIR=/opt/cello-demo/.cello
Environment=CELLO_AGENT_NAME=default
Environment=CELLO_ENV=local

[Install]
WantedBy=multi-user.target
