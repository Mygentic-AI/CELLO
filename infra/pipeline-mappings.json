{
  "packageMappings": [
    {
      "prefix": "packages/crypto/",
      "pipelines": [
        "cello-crypto-pipeline",
        "cello-protocol-types-pipeline",
        "cello-transport-pipeline",
        "cello-client-pipeline",
        "cello-adapter-claude-code-pipeline",
        "cello-directory-pipeline",
        "cello-relay-pipeline",
        "cello-e2e-tests-pipeline"
      ],
      "description": "crypto is a shared dependency — changing it triggers all downstream pipelines"
    },
    {
      "prefix": "packages/protocol-types/",
      "pipelines": [
        "cello-protocol-types-pipeline",
        "cello-transport-pipeline",
        "cello-client-pipeline",
        "cello-adapter-claude-code-pipeline",
        "cello-directory-pipeline",
        "cello-relay-pipeline",
        "cello-e2e-tests-pipeline"
      ],
      "description": "protocol-types is consumed by transport, client, adapters, directory, relay, e2e-tests"
    },
    {
      "prefix": "packages/transport/",
      "pipelines": [
        "cello-transport-pipeline",
        "cello-client-pipeline",
        "cello-adapter-claude-code-pipeline",
        "cello-directory-pipeline",
        "cello-relay-pipeline",
        "cello-e2e-tests-pipeline"
      ],
      "description": "transport is consumed by client, adapters, directory, relay, e2e-tests"
    },
    {
      "prefix": "packages/client/",
      "pipelines": [
        "cello-client-pipeline",
        "cello-adapter-claude-code-pipeline",
        "cello-e2e-tests-pipeline"
      ],
      "description": "client is consumed by adapter-claude-code and e2e-tests"
    },
    {
      "prefix": "packages/adapter-claude-code/",
      "pipelines": [
        "cello-adapter-claude-code-pipeline"
      ],
      "description": "adapter-claude-code is a leaf package"
    },
    {
      "prefix": "packages/directory/",
      "pipelines": [
        "cello-directory-pipeline"
      ],
      "description": "directory is a leaf package"
    },
    {
      "prefix": "packages/relay/",
      "pipelines": [
        "cello-relay-pipeline"
      ],
      "description": "relay is a leaf package"
    },
    {
      "prefix": "packages/e2e-tests/",
      "pipelines": [
        "cello-e2e-tests-pipeline"
      ],
      "description": "e2e-tests is a leaf package"
    },
    {
      "prefix": "packages/operations-agent/",
      "pipelines": [
        "cello-operations-agent-pipeline"
      ],
      "description": "operations-agent is a leaf package — Telegram/SES registration bot"
    }
  ],
  "rootConfigFiles": [
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    "package.json"
  ],
  "allCelloPipelines": [
    "cello-crypto-pipeline",
    "cello-protocol-types-pipeline",
    "cello-transport-pipeline",
    "cello-client-pipeline",
    "cello-adapter-claude-code-pipeline",
    "cello-directory-pipeline",
    "cello-relay-pipeline",
    "cello-e2e-tests-pipeline",
    "cello-operations-agent-pipeline"
  ]
}
