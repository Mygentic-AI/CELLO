{
  "name": "trustless-cello",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:all": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "eslint packages/*/src",
    "dev": "pnpm --filter @cello-protocol/directory run start & pnpm --filter @cello-protocol/relay run start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@journeyapps/sqlcipher",
      "esbuild",
      "better-sqlite3",
      "argon2",
      "@oqs/liboqs-js",
      "agentdb",
      "hnswlib-node",
      "cbor-extract",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "@libp2p/interface": "3.2.2"
    }
  },
  "devDependencies": {
    "@claude-flow/testing": "3.0.0-alpha.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
