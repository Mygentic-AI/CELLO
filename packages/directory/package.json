{
  "name": "@cello-protocol/directory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./network-relay-adapter.js": {
      "import": "./dist/network-relay-adapter.js",
      "types": "./dist/network-relay-adapter.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "start": "node dist/bin/directory.js",
    "analytics:run": "node --import tsx/esm src/bin/analytics-run.ts",
    "db:migrate": "docker compose run --rm flyway",
    "db:seed": "node --import tsx/esm db/seed.ts"
  },
  "bin": {
    "cello-directory": "./dist/bin/directory.js"
  },
  "devDependencies": {
    "@cello-protocol/client": "^0.0.31",
    "@cello-protocol/relay": "workspace:*",
    "@claude-flow/testing": "3.0.0-alpha.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/pg": "8.20.0",
    "tsx": "^4.0.0",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1051.0",
    "@aws-sdk/client-secrets-manager": "3.1051.0",
    "@cello-protocol/crypto": "^0.0.7",
    "@cello-protocol/interfaces": "workspace:*",
    "@cello-protocol/protocol-types": "^0.0.3",
    "@cello-protocol/transport": "^0.0.4",
    "@libp2p/interface": "^3.0.0",
    "@noble/curves": "2.2.0",
    "cbor-x": "^1.6.4",
    "it-length-prefixed": "^9.1.0",
    "pg": "8.18.0"
  }
}
